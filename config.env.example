# ============================================================================
# HA-SHEM VAPT ENGAGEMENT — CONFIGURATION TEMPLATE
# ============================================================================
# Copy this file to config.env and fill in non-sensitive values.
# NEVER commit config.env to version control.
# Credentials and secrets are prompted at runtime — do NOT put them here.
# ============================================================================

# ─── ENGAGEMENT META ─────────────────────────────────────────────────────────
ENGAGEMENT_NAME="HaShem-VAPT-2026"
ENGAGEMENT_DATE="2026-04-01"
OUTPUT_BASE_DIR="${HOME}/vapt"

# ─── NETWORK SCOPE ───────────────────────────────────────────────────────────
# Space-separated list of subnets in CIDR notation
TARGET_SUBNETS="10.10.0.0/24 10.10.1.0/24 192.168.1.0/24"

# Your attacker machine's network interface (run: ip addr show)
ATTACKER_INTERFACE="eth0"

# Your attacker machine's IP on the internal network
ATTACKER_IP="10.10.0.50"

# ─── ACTIVE DIRECTORY ────────────────────────────────────────────────────────
DOMAIN_NAME="hashem.local"
DC_IP="10.10.1.10"
# Optional: space-separated if multiple DCs
ADDITIONAL_DC_IPS=""

# ─── AZURE / ENTRA ID ────────────────────────────────────────────────────────
AZURE_TENANT_ID="xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
# Space-separated list if multiple subscriptions
AZURE_SUBSCRIPTION_IDS="xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"

# ─── SCAN TIMING / BEHAVIOUR ─────────────────────────────────────────────────
# Nmap timing template: 1 (slowest/stealthy) to 5 (fastest/noisy). 4 recommended.
NMAP_TIMING="4"

# Max parallel Nmap host groups (lower = less network impact)
NMAP_MIN_HOSTGROUP="32"

# Hashcat device type: 1=CPU, 2=GPU (GPU dramatically faster — use if available)
HASHCAT_DEVICE="1"

# Responder run duration in seconds (default: 7200 = 2 hours)
RESPONDER_DURATION="7200"

# ─── WORDLISTS ────────────────────────────────────────────────────────────────
WORDLIST_PRIMARY="/usr/share/wordlists/rockyou.txt"
WORDLIST_RULES="/usr/share/hashcat/rules/best64.rule"
WORDLIST_CORPORATE="/usr/share/wordlists/corporate_patterns.txt"

# ─── TOOL PATHS (override if tools are not in PATH) ──────────────────────────
NMAP_BIN="nmap"
# CME_BIN: auto-detected at runtime (nxc on Kali 2024+, crackmapexec on older).
# Override here only if auto-detection fails.
CME_BIN=""
RESPONDER_BIN="responder"
HASHCAT_BIN="hashcat"
BLOODHOUND_BIN="bloodhound-python"
ROADRECON_BIN="roadrecon"
# ScoutSuite is invoked as "scout suite" (two words). Auto-detected via set_scout_cmd().
# Override not required — set_scout_cmd() in lib/common.sh handles detection.
CERTIPY_BIN="certipy-ad"

# ─── WEB APPLICATION TARGETS (DAST — OWASP ZAP) ─────────────────────────────
# Space-separated list of in-scope web app base URLs for automated DAST scanning.
# ZAP runs via Docker (no Java install required). Leave empty to skip DAST.
WEB_TARGETS="http://intranet.hashem.local https://portal.hashem.local"

# ZAP scan mode:
#   "baseline" — passive scan only (safe, no active attacks, fast, good for first pass)
#   "full"     — active scan (sends attack payloads, slower, noisier — confirm RoE covers this)
ZAP_SCAN_MODE="baseline"

# ─── ROADRECON AUTH ──────────────────────────────────────────────────────────
# "password" = legacy basic auth (works only if tenant has no MFA/CA policies)
# "devicecode" = interactive device code flow (works on all modern tenants — runs
#                in foreground, not background, requires operator at keyboard)
ROADRECON_AUTH_METHOD="password"

# ─── NESSUS (optional) ───────────────────────────────────────────────────────
# NESSUS_SCAN_ID: ID of a pre-configured credentialed scan policy in Nessus.
# Retrieve from Nessus UI (Scans > your scan > URL contains /scans/<ID>).
# Leave empty to skip automated Nessus trigger — launch manually from UI.
NESSUS_SCAN_ID=""

# ─── PASSWORD SPRAY (phase 1 optional step) ──────────────────────────────────
# Set SPRAY_ENABLED="true" to add a controlled spray pass in Phase 1.
# SPRAY_MAX_ATTEMPTS must be below domain lockout threshold (check Phase 2 output).
SPRAY_ENABLED="false"
SPRAY_MAX_ATTEMPTS="2"
SPRAY_DELAY_SECONDS="1800"

# ─── NOTIFICATION (optional — set to send alerts when background jobs finish) ─
# Leave empty to disable. Requires 'notify-send' (Linux desktop) or 'curl' for webhook.
SLACK_WEBHOOK_URL=""
NOTIFY_ON_JOB_COMPLETE="true"

# ─── OPERATIONAL CONSTRAINTS ──────────────────────────────────────────────────
# Business hours only enforcement (HH:MM format, 24hr)
TESTING_WINDOW_START="09:00"
TESTING_WINDOW_END="17:00"

# Set to "true" to enforce business hours check before each phase
ENFORCE_TESTING_WINDOW="true"

# Emergency stop contact (displayed in UI at start)
EMERGENCY_CONTACT="Management Sponsor — Elizabeth A."
